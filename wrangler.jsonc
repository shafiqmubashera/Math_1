// Cloudflare settings: publish the student app (built into dist/ by tools/build.mjs) as static files,
// plus a small Worker (worker/index.js) that keeps the Feedback forms and shows them at /inbox.
// Cloudflare build command: rm -rf dist && node tools/build.mjs   Deploy command: npx wrangler deploy
{
  "name": "math-1",
  "main": "worker/index.js",
  "compatibility_date": "2025-11-01",
  "assets": { "directory": "./dist" },
  // Feedback storage: one Durable Object with its own SQLite database. Nothing to create by hand.
  "durable_objects": { "bindings": [{ "name": "FEEDBACK_DB", "class_name": "FeedbackStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FeedbackStore"] }],
  // Lets Cloudflare build a preview copy of each pull request (npx wrangler preview).
  "previews": {}
}
